# Copie este arquivo para .env e preencha com os endereços do ambiente a testar.
# O .env não vai para o git.

# URL completa da landing page.
LP_URL=https://seu-ambiente.example.com/caminho/da/pagina

# API que a página chama ao abrir para carregar os ingressos (opcional).
# Usada no cenário 1 para simular o que o navegador faz de verdade ao abrir a página.
# Para descobrir: abra a página com o DevTools do navegador na aba Rede (Network), filtre por
# Fetch/XHR e copie a URL da chamada que termina em /ticket-picker.
LP_API_INGRESSOS=https://api.example.com/v1/events/123/ticket-picker
