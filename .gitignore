node_modules/

# URL do ambiente testado (veja .env.example)
.env

# Arquivos locais que podem ter endereços do ambiente (ex.: prompt de preparo da máquina)
*.local.*

# Processor compilado pelo Artillery
src/dist/

# Gravações do Cypress e cenários gerados a partir delas (contêm as URLs do ambiente)
gravacoes/
tests/gerado/
cypress/screenshots/
cypress/videos/

# Relatórios e dados gerados a cada execução
reports/*.html
reports/dados/
